# Desenvolvimento: `ng serve` com hot reload; bind mount do código em docker-compose.
FROM node:20-bookworm-slim

WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY examples ./examples

RUN npm ci

ENV CHOKIDAR_USEPOLLING=true
EXPOSE 20052

# API no host: o browser chama http://localhost:<SERVER_PORT> (ver environment.ts)
CMD ["npm", "run", "start", "-w", "@junny/web", "--", "--host", "0.0.0.0", "--port", "20052"]
