generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Collection {
  id          String          @id @default(cuid())
  workspaceId String?
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Auth predefinida (JSON); pedidos podem sobrepor com authConfig próprio.
  authConfig  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  requests    StoredRequest[]

  @@index([workspaceId])
}

model StoredRequest {
  id           String      @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// REST, GRAPHQL, SOAP ou WEBSOCKET
  protocol     String      @default("REST")
  method       String
  url          String
  headers      Json
  /// Query params guardados (objeto chave/valor)
  params       Json        @default("{}")
  /// Tag OpenAPI (agrupamento)
  tag          String?
  /// Variáveis GraphQL (JSON)
  graphqlVariables Json?
  body         String?
  /// Auth específica; null herda da collection.
  authConfig   Json?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([workspaceId])
  @@index([collectionId])
}

model Environment {
  id        String                @id @default(cuid())
  workspaceId String?
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  variables EnvironmentVariable[]

  @@index([workspaceId])
}

model EnvironmentVariable {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  key           String
  value         String

  @@unique([environmentId, key])
}

model HistoryEntry {
  id        String   @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   Json
  response  Json
  status    Int
  duration  Int
  createdAt DateTime @default(now())
  /// REST | GRAPHQL | SOAP (denormalizado para listagem e filtros)
  protocol  String   @default("REST")
  method    String   @default("GET")
  url       String   @default("")

  @@index([workspaceId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  WorkspaceMember[]
  sentWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteInvitedBy")
}

model Workspace {
  id         String            @id @default(cuid())
  name       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    WorkspaceMember[]
  invites    WorkspaceInvite[]
  collections Collection[]
  environments Environment[]
  storedRequests StoredRequest[]
  history    HistoryEntry[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("owner") // owner | editor | viewer
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email         String
  role          String    @default("viewer")
  token         String    @unique
  expiresAt     DateTime
  invitedByUserId String?
  invitedByUser   User?   @relation("WorkspaceInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([email])
}
