{
  "name": "@junny/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:db": "node scripts/reset-test-db.cjs && cross-env DATABASE_URL=file:./prisma/test.db prisma migrate deploy",
    "test": "npm run test:db && jest --runInBand",
    "test:cov": "npm run test:db && jest --runInBand --coverage"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^6.3.1",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger2openapi": "^7.0.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.1",
    "typescript": "^5.5.0"
  }
}
