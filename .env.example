# Copiar para `.env` na raiz (opcional). O Docker Compose lê estes valores.
# Não comitar `.env` — já está no `.gitignore`.

# Dev (`docker compose up`): portas no host → contentores 20052 (web) / 20053 (API).
WEB_PORT=20052
SERVER_PORT=20053

# Prod (`docker compose -f docker-compose.prod.yml`): obrigatório em produção real.
# JWT_SECRET=…
# JUNNY_WEB_HOST_PORT=20052
# JUNNY_API_HOST_PORT=20053

# Nest — JWT (obrigatório em produção; em dev pode omitir — há fallback inseguro no código).
JWT_SECRET=9f4c2d8b7e61a3f5c0d9e8a1b6f74c3e2a5d9f0b7c1e4a8d6f3b2c9e1a7d5f8

# Synapto Identity — cadastro atribui perfil JUNNY_USER (POST /auth/register M2M)
# IDENTITY_ENABLED=true
# IDENTITY_SERVICE_URL=https://api-identity.synapto.com.br
# IDENTITY_CLIENT_ID=junny
# IDENTITY_CLIENT_SECRET=
# IDENTITY_TENANT_SLUG=synapto-tech

# Docker Desktop (Mac/Windows): polling ajuda o hot reload em volumes montados.
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
